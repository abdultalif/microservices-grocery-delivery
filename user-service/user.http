### Forgot Password
POST {{base_url}}/api/v1/auth/forgot-password
Accept: application/json
Content-Type: application/json

{
    "email": "abdultalif55@gmail.com"
}

### Verification Token Reset Password
GET {{base_url}}/api/v1/auth/validate-forgot-token?token={{token_reset_password}}
Accept: application/json
Content-Type: application/json

### Reset Password
PATCH {{base_url}}/api/v1/auth/reset-password?token={{token_reset_password}}
Accept: application/json
Content-Type: application/json

{
    "password_new": "admin123",
    "password_confirmation": "admin123"

}

### Register
POST {{base_url}}/api/v1/auth
Accept: application/json
Content-Type: application/json

{
    "email": "abdultalif55@gmail.com",
    "password": "admin123",
    "name": "Abdul Talif P",
    "confirm_password": "admin123"
}

### Varify Account User
GET {{base_url}}/api/v1/auth/verify-account?token={{token_verify_account}}
Accept: application/json
Content-Type: application/json



### Profile
GET {{base_url}}/api/v1/profile
Accept: application/json
Content-Type: application/json
Authorization: {{token_super_admin}}

### Change Password
PATCH  {{base_url}}/api/v1/change-password
Accept: application/json
Content-Type: application/json
Authorization: {{token_customer}}

{
    "current_password": "talif12345",
    "password_new": "talif123",
    "password_confirmation": "talif123"
}


### Create Role
POST {{base_url}}/api/v1/admin/role
Accept: application/json
Content-Type: application/json
Authorization: {{token_super_admin}}

{
    "name": "Customer"
}

### Delete Role
DELETE {{base_url}}/api/v1/admin/role/7
Accept: application/json
Content-Type: application/json
Authorization: {{token_super_admin}}

### Get Role By ID
GET {{base_url}}/api/v1/admin/role/7
Accept: application/json
Content-Type: application/json
Authorization: {{token_super_admin}}

### Get All Role
GET {{base_url}}/api/v1/admin/role?search=
Accept: application/json
Content-Type: application/json
Authorization: {{token_super_admin}}

