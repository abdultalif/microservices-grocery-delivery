@category_id = eea8aeef-99d8-4bd7-a331-67c962d40bb3

### Get all categories
GET {{baseUrl}}?search=&orderBy=&orderType=desc&page=1&perPage=
Accept: application/json
Authorization: Bearer {{accessTokenSuperAdmin}}


### Get category by ID
GET {{baseUrl}}/{{category_id}}
Accept: application/json
Authorization: Bearer {{accessTokenSuperAdmin}}


### Delete category by ID
DELETE {{baseUrl}}/{{category_id}}
Accept: application/json
Authorization: Bearer {{accessTokenSuperAdmin}}


### Create new category
POST {{baseUrl}}
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{accessTokenSuperAdmin}}

{
    "name": "furniture",
    "parent_id": "edc0a8ad-1770-4f1c-bcd1-a4af79a16ff7",
    "icon": "http://",
    "status": "Published",
    "description": "test"
}

### Update new category
PATCH {{baseUrl}}/{{category_id}}
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{accessTokenSuperAdmin}}

{
    "icon": "Adik kecil",
    "name": "test"
}

### Get category by slug
GET {{baseUrl}}/furniture/slug
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{accessTokenSuperAdmin}}